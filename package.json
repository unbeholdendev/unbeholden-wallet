{
  "name": "unbeholden-wallet",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && vite build --mode demo",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:integration": "bun --bun vitest run -c integration/vitest.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p integration",
    "regtest:up": "scripts/regtest/up.sh",
    "regtest:down": "scripts/regtest/down.sh",
    "regtest:fixture": "bun scripts/regtest/cli.ts fixture",
    "regtest:fund": "bun scripts/regtest/cli.ts fund",
    "regtest:mine": "bun scripts/regtest/cli.ts mine",
    "regtest:reorg": "bun scripts/regtest/cli.ts reorg",
    "hashes": "cd dist && find . -type f | LC_ALL=C sort | xargs sha256sum"
  },
  "dependencies": {
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "@scure/bip32": "^2.4.0",
    "@scure/btc-signer": "^2.4.1",
    "qr": "^0.7.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
