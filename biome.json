{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!site", "!docs", "!**/*.md", "!**/*.svg"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noAutofocus": "off",
        "useSemanticElements": "off",
        "useValidAnchor": "off"
      },
      "complexity": {
        "noCommaOperator": "off",
        "noImportantStyles": "off"
      },
      "correctness": {
        "useExhaustiveDependencies": "off",
        "useJsxKeyInIterable": "off",
        "noComponentHookFactories": "off"
      },
      "style": {
        "noDescendingSpecificity": "off",
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noAssignInExpressions": "off",
        "noExplicitAny": "off",
        "useIterableCallbackReturn": "off"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["src/wallet/**", "!**/*.test.*"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/transport/**",
                      "**/vault/**",
                      "**/backend/**",
                      "**/core/**",
                      "**/ui/**",
                      "**/app/**",
                      "**/screens/**"
                    ],
                    "message": "src/wallet may not import from a layer above it. See the layer order in AGENTS.md."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/transport/**", "!**/*.test.*"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/vault/**", "**/backend/**", "**/core/**", "**/ui/**", "**/app/**", "**/screens/**"],
                    "message": "src/transport may not import from a layer above it. See the layer order in AGENTS.md."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/vault/**", "!**/*.test.*"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/wallet/**",
                      "**/transport/**",
                      "**/backend/**",
                      "**/core/**",
                      "**/ui/**",
                      "**/app/**",
                      "**/screens/**"
                    ],
                    "message": "src/vault may not import from a layer above it. See the layer order in AGENTS.md."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/backend/**", "!**/*.test.*"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/transport/**", "**/vault/**", "**/core/**", "**/ui/**", "**/app/**", "**/screens/**"],
                    "message": "src/backend may not import from a layer above it. See the layer order in AGENTS.md."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/core/**", "!**/*.test.*"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/ui/**", "**/app/**", "**/screens/**"],
                    "message": "src/core may not import from a layer above it. See the layer order in AGENTS.md."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/ui/**", "!**/*.test.*"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/app/**", "**/screens/**"],
                    "message": "src/ui may not import from a layer above it. See the layer order in AGENTS.md."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/app/**", "!**/*.test.*"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/screens/**"],
                    "message": "src/app may not import from a layer above it. See the layer order in AGENTS.md."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
